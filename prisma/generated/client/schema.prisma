generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// PLATFORM CORE (SaaS Foundation)
// ==========================================

enum BusinessType {
  service
  trading
  manufacturing
  hybrid
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
  expired
}

enum BillingInterval {
  trial
  monthly
  yearly
}

enum SetupStage {
  subscription // Step 1: Plan selected
  company_profile // Step 2: Company details filled
  finance_setup // Step 3: COA + Tax + FY configured
  roles_setup // Step 4: At least one role created
  completed // All gates passed
}

model Tenant {
  id                   String       @id @default(uuid())
  name                 String // Company legal name
  trade_license        String?
  business_type        BusinessType @default(service)
  industry             String? // e.g. "Engineering & Construction"
  country              String       @default("AE")
  currency             String       @default("AED")
  tax_regime           String       @default("VAT") // VAT, GST, Sales Tax
  timezone             String       @default("Asia/Dubai")
  financial_year_start Int          @default(1) // Month number: 1=Jan, 4=Apr
  logo_url             String?

  // Setup progress tracking
  setup_stage            SetupStage @default(subscription)
  company_setup_complete Boolean    @default(false)
  finance_setup_complete Boolean    @default(false)
  roles_setup_complete   Boolean    @default(false)

  // Feature flags (from subscription)
  module_finance    Boolean @default(true) // Always on (core)
  module_sales      Boolean @default(false)
  module_operations Boolean @default(false)
  module_hr         Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  users         User[]
  subscriptions Subscription[]

  @@map("tenants")
}

model SubscriptionPlan {
  id          String  @id @default(uuid())
  name        String // e.g. "Starter", "Professional", "Enterprise"
  code        String  @unique // e.g. "starter", "pro", "enterprise"
  description String?

  // Pricing
  price_monthly Decimal @db.Decimal(10, 2)
  price_yearly  Decimal @db.Decimal(10, 2)
  trial_days    Int     @default(14)

  // Feature access
  max_users         Int     @default(5)
  module_finance    Boolean @default(true) // Always included
  module_sales      Boolean @default(false)
  module_operations Boolean @default(false)
  module_hr         Boolean @default(false)
  module_reports    Boolean @default(true) // Always included

  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               String             @id @default(uuid())
  tenant_id        String
  plan_id          String
  status           SubscriptionStatus @default(trial)
  billing_interval BillingInterval    @default(trial)

  // Dates
  trial_start          DateTime?
  trial_end            DateTime?
  current_period_start DateTime?
  current_period_end   DateTime?
  cancelled_at         DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [plan_id], references: [id])

  @@map("subscriptions")
}

// ==========================================
// USER & AUTH
// ==========================================

enum UserRole {
  client
  admin
}

enum ProjectStatus {
  pending
  under_review
  accepted
  in_progress
  testing
  completed
  cancelled
}

enum FileType {
  document
  voice_note
  image
  other
}

enum SupportStatus {
  open
  in_progress
  resolved
  closed
}

enum PriorityLevel {
  low
  medium
  high
}

enum MeetingStatus {
  pending
  accepted
  declined
  completed
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
}

enum MemberStatus {
  active
  inactive
}

enum NotificationType {
  project
  payment
  support
  meeting
  system
}

enum TransactionType {
  income
  expense
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String? // Added for custom auth
  full_name  String
  role       UserRole @default(client)
  avatar_url String?

  // Tenant / Multi-tenancy
  tenant_id String?
  tenant    Tenant? @relation(fields: [tenant_id], references: [id])

  // Module-level permissions (overrides from role)
  erp_role String? // super_admin, finance, hr, sales, operations, viewer

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  projects          Project[]
  project_files     ProjectFile[]
  project_updates   ProjectUpdate[]
  support_requests  SupportRequest[]
  support_messages  SupportMessage[]
  meeting_requests  MeetingRequest[]
  invoices          Invoice[]
  notifications     Notification[]
  transactions      Transaction[]
  inventory_logs    InventoryTransaction[]
  purchase_requests PurchaseRequest[]
  purchase_orders   PurchaseOrder[]
  grns              GRN[]
  journal_entries   JournalEntry[]
  stock_journals    StockJournal[]

  // CRM Relations
  leads_owned             Lead[]            @relation("LeadOwner")
  customer_accounts_owned CustomerAccount[] @relation("AccountOwner")
  opportunities_owned     Opportunity[]     @relation("OpportunityOwner")
  activities              Activity[]

  // Approval Relations
  approval_requests_made     ApprovalRequest[] @relation("RequestedApprovals")
  approval_requests_actioned ApprovalRequest[] @relation("ActionedApprovals")

  // Sales & Project Relations
  created_quotes      Quote[]
  created_orders      SalesOrder[]
  timesheet_entries   TimesheetEntry[]
  expense_claims      ExpenseClaim[]
  timesheets_approved TimesheetEntry[]  @relation("TimesheetApprover")
  expenses_approved   ExpenseClaim[]    @relation("ExpenseApprover")
  resource_bookings   ResourceBooking[]

  // Phase 7 Relations
  performance_goals PerformanceGoal[]
  reviews_received  PerformanceReview[] @relation("Reviewee")
  reviews_given     PerformanceReview[] @relation("Reviewer")

  @@map("users")
}

model Project {
  id                String        @id @default(uuid())
  client_id         String
  title             String
  description       String
  status            ProjectStatus @default(pending)
  github_link       String?
  estimated_cost    Decimal?      @db.Decimal(10, 2)
  actual_cost       Decimal?      @db.Decimal(10, 2)
  deadline          DateTime?     @db.Date
  test_asset_url    String?
  deployment_url    String?
  live_preview_type String?       @default("url")
  live_preview_url  String?
  technical_config  Json?
  tickets           Json?
  notes             String[]

  // Node-Based Module Data
  labour_data    Json? @default("[]")
  inventory_data Json? @default("[]")
  resources_data Json? @default("[]")
  design_data    Json? @default("[]")
  expenses_data  Json? @default("[]")
  timeline_data  Json? @default("[]")

  is_featured Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  client             User                   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  files              ProjectFile[]
  updates            ProjectUpdate[]
  support_requests   SupportRequest[]
  meeting_requests   MeetingRequest[]
  invoices           Invoice[]
  inventory_logs     InventoryTransaction[]
  purchase_requests  PurchaseRequest[]
  attendance         Attendance[]
  labour_allocations LabourAllocation[]

  // Phase 6 Relations
  quotes            Quote[]
  sales_orders      SalesOrder[]
  timesheet_entries TimesheetEntry[]
  expense_claims    ExpenseClaim[]
  resource_bookings ResourceBooking[]

  @@map("projects")
}

model ProjectFile {
  id          String   @id @default(uuid())
  project_id  String
  file_name   String
  file_url    String
  file_type   FileType @default(document)
  file_size   BigInt
  uploaded_by String
  created_at  DateTime @default(now())

  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model ProjectUpdate {
  id          String   @id @default(uuid())
  project_id  String
  update_text String
  created_by  String
  created_at  DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@map("project_updates")
}

model SupportRequest {
  id          String        @id @default(uuid())
  project_id  String?
  client_id   String
  subject     String
  description String
  status      SupportStatus @default(open)
  priority    PriorityLevel @default(medium)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  project  Project?         @relation(fields: [project_id], references: [id])
  client   User             @relation(fields: [client_id], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@map("support_requests")
}

model SupportMessage {
  id                 String   @id @default(uuid())
  support_request_id String
  user_id            String
  message            String
  created_at         DateTime @default(now())

  request SupportRequest @relation(fields: [support_request_id], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model MeetingRequest {
  id               String        @id @default(uuid())
  project_id       String?
  client_id        String
  requested_date   DateTime
  duration_minutes Int           @default(30)
  purpose          String
  status           MeetingStatus @default(pending)
  meeting_link     String?
  admin_notes      String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  project Project? @relation(fields: [project_id], references: [id])
  client  User     @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@map("meeting_requests")
}

enum PostingStatus {
  draft
  posted
  voided
}

model Invoice {
  id             String        @id @default(uuid())
  project_id     String? // Made optional to support direct invoices
  client_id      String? // Made optional in favor of customer_id
  customer_id    String? // Link to CRM CustomerAccount
  invoice_number String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  tax_amount     Decimal?      @default(0) @db.Decimal(10, 2)
  tax_breakdown  Json? // Detailed tax breakdown { cgst, sgst, igst, vat, etc. }
  total_amount   Decimal       @db.Decimal(10, 2) // amount + tax_amount
  currency       String        @default("USD")
  exchange_rate  Decimal?      @default(1.0) @db.Decimal(10, 4)
  due_date       DateTime      @db.Date
  status         InvoiceStatus @default(pending)
  posting_status PostingStatus @default(draft)
  payment_qr_url String?
  bank_details   Json?
  notes          String?
  terms          String?
  paid_at        DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  project                  Project?                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  client                   User?                   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  customer                 CustomerAccount?        @relation(fields: [customer_id], references: [id])
  payments                 Payment[]
  lines                    InvoiceLine[]
  credit_notes             CreditNote[]
  credit_note_applications CreditNoteApplication[]

  @@map("invoices")
}

model InvoiceLine {
  id           String   @id @default(uuid())
  invoice_id   String
  description  String
  quantity     Decimal  @db.Decimal(10, 2)
  unit_price   Decimal  @db.Decimal(10, 2)
  amount       Decimal  @db.Decimal(10, 2) // quantity * unit_price
  tax_rate_id  String?
  tax_amount   Decimal? @default(0) @db.Decimal(10, 2)
  total_amount Decimal  @db.Decimal(10, 2) // amount + tax_amount
  sort_order   Int      @default(0)

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model Payment {
  id             String   @id @default(uuid())
  invoice_id     String
  amount         Decimal  @db.Decimal(10, 2)
  payment_method String
  transaction_id String?
  payment_date   DateTime @default(now())
  notes          String?
  created_at     DateTime @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

// --- HR Module ---

enum EmployeeLifecycleStatus {
  probation
  confirmed
  notice_period
  resigned
  terminated
  retired
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum HREventType {
  hiring
  appraisal
  promotion
  transfer
  warning
  layoff
  exit
}

model Department {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  head_id    String? // Employee who heads the department
  parent_id  String? // For department hierarchy
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent    Department?  @relation("DeptHierarchy", fields: [parent_id], references: [id])
  children  Department[] @relation("DeptHierarchy")
  employees Employee[]

  @@map("departments")
}

model HRRole {
  id         String   @id @default(uuid())
  code       String   @unique
  title      String
  grade      String? // e.g., "L1", "L2", "Manager"
  min_salary Decimal? @db.Decimal(10, 2)
  max_salary Decimal? @db.Decimal(10, 2)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employee[]

  @@map("hr_roles")
}

model Employee {
  id              String       @id @default(uuid())
  employee_id     String       @unique // Custom ID like EMP-001
  name            String
  role            String // Designation (legacy text)
  skill_type      String // Welder, Fitter, Helper
  employment_type String // Permanent, Contract, Daily
  department      String? // Legacy text field
  joining_date    DateTime     @db.Date
  basic_salary    Decimal      @default(0) @db.Decimal(10, 2)
  overtime_rate   Decimal      @default(0) @db.Decimal(10, 2)
  bank_details    Json? // IBAN, Bank Name, WPS ID
  status          MemberStatus @default(active)

  // Extended HR fields
  email             String?
  phone             String?
  date_of_birth     DateTime? @db.Date
  gender            String? // male, female, other
  blood_group       String?
  marital_status    String? // single, married, divorced
  nationality       String?
  address           String?
  emergency_contact Json? // { name, phone, relation }
  photo_url         String?

  // Lifecycle
  lifecycle_status  EmployeeLifecycleStatus @default(probation)
  confirmation_date DateTime?               @db.Date
  resignation_date  DateTime?               @db.Date
  exit_date         DateTime?               @db.Date
  exit_reason       String?

  // Statutory
  pf_number     String?
  esi_number    String?
  uan_number    String? // Universal Account Number
  pan_number    String?
  aadhar_number String?

  // Relations to new models
  department_id String?
  hr_role_id    String?

  dept    Department? @relation(fields: [department_id], references: [id])
  hr_role HRRole?     @relation(fields: [hr_role_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  attendance        Attendance[]
  allocations       LabourAllocation[]
  payroll_items     PayrollLine[]
  documents         EmployeeDocument[]
  leaves            Leave[]
  salary_structures SalaryStructure[]
  hr_events         HREvent[]

  @@map("employees")
}

model EmployeeDocument {
  id          String    @id @default(uuid())
  employee_id String
  name        String // e.g. "Passport", "ID Proof"
  doc_type    String // identity, education, experience, contract, other
  file_url    String?
  file_name   String?
  expiry_date DateTime? @db.Date
  notes       String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model Attendance {
  id             String    @id @default(uuid())
  employee_id    String
  date           DateTime  @db.Date
  status         String // present, absent, half_day
  overtime_hours Float     @default(0)
  project_id     String? // Link to project cost
  check_in       DateTime?
  check_out      DateTime?
  notes          String?
  created_at     DateTime  @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])
  project  Project? @relation(fields: [project_id], references: [id])

  @@unique([employee_id, date])
  @@map("attendance")
}

model LeaveType {
  id            String   @id @default(uuid())
  code          String   @unique // CL, SL, EL, etc.
  name          String // Casual Leave, Sick Leave, Earned Leave
  days_per_year Int      @default(0)
  is_paid       Boolean  @default(true)
  carry_forward Boolean  @default(false)
  max_carry     Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  leaves Leave[]

  @@map("leave_types")
}

model Leave {
  id            String      @id @default(uuid())
  employee_id   String
  leave_type_id String
  from_date     DateTime    @db.Date
  to_date       DateTime    @db.Date
  days          Decimal     @db.Decimal(4, 1) // 1, 0.5, etc.
  reason        String?
  status        LeaveStatus @default(pending)
  approved_by   String?
  approved_at   DateTime?
  remarks       String? // Manager remarks
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  employee   Employee  @relation(fields: [employee_id], references: [id])
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id])

  @@map("leaves")
}

model Holiday {
  id         String   @id @default(uuid())
  name       String
  date       DateTime @db.Date
  type       String   @default("public") // public, restricted, optional
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([date])
  @@map("holidays")
}

model SalaryStructure {
  id                String   @id @default(uuid())
  employee_id       String
  effective_from    DateTime @db.Date
  basic             Decimal  @db.Decimal(10, 2)
  hra               Decimal  @default(0) @db.Decimal(10, 2) // House Rent Allowance
  da                Decimal  @default(0) @db.Decimal(10, 2) // Dearness Allowance
  ta                Decimal  @default(0) @db.Decimal(10, 2) // Travel Allowance
  special_allowance Decimal  @default(0) @db.Decimal(10, 2)
  pf_employee       Decimal  @default(0) @db.Decimal(10, 2) // Employee PF contribution
  pf_employer       Decimal  @default(0) @db.Decimal(10, 2) // Employer PF contribution
  esi_employee      Decimal  @default(0) @db.Decimal(10, 2)
  esi_employer      Decimal  @default(0) @db.Decimal(10, 2)
  professional_tax  Decimal  @default(0) @db.Decimal(10, 2)
  tds               Decimal  @default(0) @db.Decimal(10, 2) // Tax Deducted at Source
  gross_salary      Decimal  @db.Decimal(10, 2)
  net_salary        Decimal  @db.Decimal(10, 2)
  is_current        Boolean  @default(true)
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])

  @@map("salary_structures")
}

model LabourAllocation {
  id          String    @id @default(uuid())
  employee_id String
  project_id  String
  start_date  DateTime  @db.Date
  end_date    DateTime? @db.Date
  status      String // active, completed
  created_at  DateTime  @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])
  project  Project  @relation(fields: [project_id], references: [id])

  @@map("labour_allocations")
}

model Payroll {
  id                  String   @id @default(uuid())
  month               String // YYYY-MM
  status              String // draft, approved, paid, posted
  total_amount        Decimal  @db.Decimal(12, 2)
  total_deductions    Decimal  @default(0) @db.Decimal(12, 2)
  total_employer_cost Decimal  @default(0) @db.Decimal(12, 2)
  approved_by         String?
  posted_to_finance   Boolean  @default(false)
  finance_journal_id  String? // Link to JournalEntry when posted
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  lines PayrollLine[]

  @@unique([month])
  @@map("payrolls")
}

model PayrollLine {
  id                String  @id @default(uuid())
  payroll_id        String
  employee_id       String
  basic_pay         Decimal @db.Decimal(10, 2)
  hra               Decimal @default(0) @db.Decimal(10, 2)
  da                Decimal @default(0) @db.Decimal(10, 2)
  ta                Decimal @default(0) @db.Decimal(10, 2)
  special_allowance Decimal @default(0) @db.Decimal(10, 2)
  overtime_pay      Decimal @db.Decimal(10, 2)
  gross_pay         Decimal @default(0) @db.Decimal(10, 2)
  pf_deduction      Decimal @default(0) @db.Decimal(10, 2)
  esi_deduction     Decimal @default(0) @db.Decimal(10, 2)
  professional_tax  Decimal @default(0) @db.Decimal(10, 2)
  tds               Decimal @default(0) @db.Decimal(10, 2)
  deductions        Decimal @default(0) @db.Decimal(10, 2)
  net_pay           Decimal @db.Decimal(10, 2)
  total_pay         Decimal @db.Decimal(10, 2)
  status            String // pending, paid

  payroll  Payroll  @relation(fields: [payroll_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id])

  @@map("payroll_lines")
}

model HREvent {
  id             String      @id @default(uuid())
  employee_id    String
  type           HREventType
  title          String
  description    String?
  event_date     DateTime    @db.Date
  effective_date DateTime?   @db.Date
  metadata       Json? // Extra data like new role, new salary, rating, etc.
  created_by     String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id])

  @@map("hr_events")
}

// Removing old TeamMember/SalaryPayment models as they are replaced
// model TeamMember ...
// model SalaryPayment ...

model Notification {
  id         String           @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       NotificationType @default(system)
  link       String?
  read       Boolean          @default(false)
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SystemSettings {
  id         String   @id @default(uuid())
  key        String   @unique
  value      Json
  updated_at DateTime @default(now())

  @@map("system_settings")
}

// Tax Rate Configuration - supports all countries
model TaxRate {
  id           String    @id @default(uuid())
  name         String // e.g., "Standard VAT", "GST 18%"
  code         String    @unique // e.g., "VAT_20", "GST_18"
  rate         Decimal   @db.Decimal(5, 2) // percentage
  type         String // VAT, GST, CGST, SGST, IGST, SALES_TAX, etc.
  country_code String // ISO country code (e.g., "US", "IN", "GB")
  region       String? // State/Province for regional taxes (e.g., "CA", "ON")
  category     String    @default("standard") // standard, reduced, zero, exempt
  description  String?
  is_compound  Boolean   @default(false) // For compound tax calculations
  is_active    Boolean   @default(true)
  valid_from   DateTime  @default(now())
  valid_until  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([country_code, is_active])
  @@index([code])
  @@map("tax_rates")
}

model Transaction {
  id               String          @id @default(uuid())
  type             TransactionType
  category         String
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("USD")
  exchange_rate    Decimal?        @default(1.0) @db.Decimal(10, 4)
  date             DateTime        @db.Date
  description      String?
  notes            String?
  payment_method   String?
  reference_number String?
  attachment_url   String?
  tax_rate_id      String?
  created_by       String
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  creator User @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// Legacy Inventory models removed in favor of SCM module

enum PurchaseStatus {
  pending
  approved
  ordered
  received
  billed
  paid
  cancelled
}

model PurchaseRequest {
  id             String         @id @default(uuid())
  project_id     String?
  item_name      String
  quantity       Float
  unit           String
  estimated_cost Decimal?       @db.Decimal(10, 2)
  priority       PriorityLevel  @default(medium)
  status         PurchaseStatus @default(pending)
  requested_by   String
  needed_by      DateTime?      @db.Date
  notes          String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  project         Project?        @relation(fields: [project_id], references: [id])
  requester       User            @relation(fields: [requested_by], references: [id])
  purchase_orders PurchaseOrder[]

  @@map("purchase_requests")
}

model Vendor {
  id             String   @id @default(uuid())
  name           String
  contact_person String?
  email          String?
  phone          String?
  address        String?
  country_code   String?  @default("US") // ISO country code for tax
  tax_id         String? // VAT/GST/Tax ID
  tax_exempt     Boolean  @default(false)
  vat_no         String? // Legacy field
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  purchase_orders PurchaseOrder[]
  vendor_bills    VendorBill[]
  debit_notes     DebitNote[]

  @@map("vendors")
}

model PurchaseOrder {
  id                  String         @id @default(uuid())
  po_number           String         @unique
  purchase_request_id String?
  vendor_id           String
  total_amount        Decimal        @db.Decimal(10, 2)
  status              PurchaseStatus @default(approved)
  created_by          String
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  purchase_request PurchaseRequest?    @relation(fields: [purchase_request_id], references: [id])
  vendor           Vendor              @relation(fields: [vendor_id], references: [id])
  creator          User                @relation(fields: [created_by], references: [id])
  grns             GRN[]
  vendor_bills     VendorBill[]
  lines            PurchaseOrderLine[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String   @id @default(uuid())
  purchase_order_id String
  description       String
  quantity          Decimal  @db.Decimal(10, 2)
  unit_price        Decimal  @db.Decimal(10, 2)
  amount            Decimal  @db.Decimal(10, 2)
  tax_rate_id       String?
  tax_amount        Decimal? @default(0) @db.Decimal(10, 2)
  total_amount      Decimal  @db.Decimal(10, 2)
  sort_order        Int      @default(0)

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
}

model GRN {
  id                String   @id @default(uuid())
  grn_number        String   @unique
  purchase_order_id String
  received_date     DateTime @default(now())
  received_by       String
  notes             String?
  created_at        DateTime @default(now())

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  receiver       User          @relation(fields: [received_by], references: [id])

  @@map("grns")
}

model VendorBill {
  id                String        @id @default(uuid())
  bill_number       String        @unique
  purchase_order_id String?
  vendor_id         String
  amount            Decimal       @db.Decimal(10, 2)
  tax_amount        Decimal?      @default(0) @db.Decimal(10, 2)
  tax_breakdown     Json? // Detailed tax breakdown
  total_amount      Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  due_date          DateTime      @db.Date
  status            InvoiceStatus @default(pending)
  posting_status    PostingStatus @default(draft)
  notes             String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  purchase_order          PurchaseOrder?         @relation(fields: [purchase_order_id], references: [id])
  vendor                  Vendor                 @relation(fields: [vendor_id], references: [id])
  vendor_payments         VendorPayment[]
  lines                   VendorBillLine[]
  debit_notes             DebitNote[]
  debit_note_applications DebitNoteApplication[]

  @@map("vendor_bills")
}

model VendorBillLine {
  id             String   @id @default(uuid())
  vendor_bill_id String
  description    String
  quantity       Decimal  @db.Decimal(10, 2)
  unit_price     Decimal  @db.Decimal(10, 2)
  amount         Decimal  @db.Decimal(10, 2)
  tax_rate_id    String?
  tax_amount     Decimal? @default(0) @db.Decimal(10, 2)
  total_amount   Decimal  @db.Decimal(10, 2)
  sort_order     Int      @default(0)

  vendor_bill VendorBill @relation(fields: [vendor_bill_id], references: [id], onDelete: Cascade)

  @@map("vendor_bill_lines")
}

model VendorPayment {
  id             String   @id @default(uuid())
  vendor_bill_id String
  amount         Decimal  @db.Decimal(10, 2)
  payment_date   DateTime @default(now())
  payment_method String
  reference_no   String?
  notes          String?
  created_at     DateTime @default(now())

  vendor_bill VendorBill @relation(fields: [vendor_bill_id], references: [id])

  @@map("vendor_payments")
}

// --- Credit Notes (Customer Returns) ---

enum CreditNoteStatus {
  draft
  posted
  applied
  refunded
  voided
}

model CreditNote {
  id             String           @id @default(uuid())
  number         String           @unique // CN-2025-001
  customer_id    String
  invoice_id     String? // Original invoice being credited
  date           DateTime         @db.Date
  amount         Decimal          @db.Decimal(10, 2) // Subtotal
  tax_amount     Decimal?         @default(0) @db.Decimal(10, 2)
  total_amount   Decimal          @db.Decimal(10, 2)
  currency       String           @default("USD")
  reason         String? // Reason for credit
  status         CreditNoteStatus @default(draft)
  posting_status PostingStatus    @default(draft)
  notes          String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  customer     CustomerAccount         @relation(fields: [customer_id], references: [id])
  invoice      Invoice?                @relation(fields: [invoice_id], references: [id])
  lines        CreditNoteLine[]
  applications CreditNoteApplication[]

  @@map("credit_notes")
}

model CreditNoteLine {
  id             String   @id @default(uuid())
  credit_note_id String
  description    String
  quantity       Decimal  @db.Decimal(10, 2)
  unit_price     Decimal  @db.Decimal(10, 2)
  amount         Decimal  @db.Decimal(10, 2)
  tax_rate_id    String?
  tax_amount     Decimal? @default(0) @db.Decimal(10, 2)
  total_amount   Decimal  @db.Decimal(10, 2)
  sort_order     Int      @default(0)

  credit_note CreditNote @relation(fields: [credit_note_id], references: [id], onDelete: Cascade)

  @@map("credit_note_lines")
}

model CreditNoteApplication {
  id             String   @id @default(uuid())
  credit_note_id String
  invoice_id     String // Invoice being paid with credit note
  amount         Decimal  @db.Decimal(10, 2)
  date           DateTime @default(now()) @db.Date
  created_at     DateTime @default(now())

  credit_note CreditNote @relation(fields: [credit_note_id], references: [id], onDelete: Cascade)
  invoice     Invoice    @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("credit_note_applications")
}

// --- Debit Notes (Vendor Returns/Chargebacks) ---

enum DebitNoteStatus {
  draft
  posted
  applied
  refunded
  voided
}

model DebitNote {
  id             String          @id @default(uuid())
  number         String          @unique // DN-2025-001
  vendor_id      String
  vendor_bill_id String? // Original bill being debited
  date           DateTime        @db.Date
  amount         Decimal         @db.Decimal(10, 2) // Subtotal
  tax_amount     Decimal?        @default(0) @db.Decimal(10, 2)
  total_amount   Decimal         @db.Decimal(10, 2)
  currency       String          @default("USD")
  reason         String? // Reason for debit
  status         DebitNoteStatus @default(draft)
  posting_status PostingStatus   @default(draft)
  notes          String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  vendor       Vendor                 @relation(fields: [vendor_id], references: [id])
  vendor_bill  VendorBill?            @relation(fields: [vendor_bill_id], references: [id])
  lines        DebitNoteLine[]
  applications DebitNoteApplication[]

  @@map("debit_notes")
}

model DebitNoteLine {
  id            String   @id @default(uuid())
  debit_note_id String
  description   String
  quantity      Decimal  @db.Decimal(10, 2)
  unit_price    Decimal  @db.Decimal(10, 2)
  amount        Decimal  @db.Decimal(10, 2)
  tax_rate_id   String?
  tax_amount    Decimal? @default(0) @db.Decimal(10, 2)
  total_amount  Decimal  @db.Decimal(10, 2)
  sort_order    Int      @default(0)

  debit_note DebitNote @relation(fields: [debit_note_id], references: [id], onDelete: Cascade)

  @@map("debit_note_lines")
}

model DebitNoteApplication {
  id             String   @id @default(uuid())
  debit_note_id  String
  vendor_bill_id String // Bill being paid with debit note
  amount         Decimal  @db.Decimal(10, 2)
  date           DateTime @default(now()) @db.Date
  created_at     DateTime @default(now())

  debit_note  DebitNote  @relation(fields: [debit_note_id], references: [id], onDelete: Cascade)
  vendor_bill VendorBill @relation(fields: [vendor_bill_id], references: [id], onDelete: Cascade)

  @@map("debit_note_applications")
}

// --- Stock Journal (Inventory GL Integration) ---

enum StockJournalType {
  adjustment
  transfer
  count
  damage
  obsolete
  revaluation
}

enum ValuationMethod {
  fifo
  lifo
  weighted_average
  standard_cost
}

model StockJournal {
  id               String           @id @default(uuid())
  number           String           @unique // SJ-2025-001
  date             DateTime         @db.Date
  type             StockJournalType
  reference        String? // PO, SO, or other reference
  reason           String?
  posting_status   PostingStatus    @default(draft)
  total_value      Decimal          @default(0) @db.Decimal(15, 2)
  valuation_method ValuationMethod  @default(fifo)
  notes            String?
  created_by       String
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  creator    User                  @relation(fields: [created_by], references: [id])
  lines      StockJournalLine[]
  gl_entries StockJournalGLEntry[]

  @@map("stock_journals")
}

model StockJournalLine {
  id               String    @id @default(uuid())
  stock_journal_id String
  variant_id       String
  from_location_id String?
  to_location_id   String?
  quantity         Decimal   @db.Decimal(10, 4)
  unit_cost        Decimal   @db.Decimal(15, 4)
  total_cost       Decimal   @db.Decimal(15, 2)
  lot_number       String?
  expiry_date      DateTime? @db.Date
  notes            String?
  sort_order       Int       @default(0)

  stock_journal StockJournal   @relation(fields: [stock_journal_id], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("stock_journal_lines")
}

model StockJournalGLEntry {
  id               String   @id @default(uuid())
  stock_journal_id String
  account_id       String
  debit            Decimal  @default(0) @db.Decimal(15, 2)
  credit           Decimal  @default(0) @db.Decimal(15, 2)
  description      String?
  created_at       DateTime @default(now())

  stock_journal StockJournal @relation(fields: [stock_journal_id], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [account_id], references: [id])

  @@map("stock_journal_gl_entries")
}

model BankAccount {
  id              String   @id @default(uuid())
  name            String
  account_number  String?
  bank_name       String?
  currency        String   @default("USD")
  current_balance Decimal  @default(0) @db.Decimal(15, 2)
  type            String   @default("bank") // bank, cash, credit_card
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  transactions BankTransaction[]

  @@map("bank_accounts")
}

model BankTransaction {
  id                    String   @id @default(uuid())
  bank_account_id       String
  date                  DateTime @db.Date
  description           String
  amount                Decimal  @db.Decimal(15, 2)
  reference             String?
  status                String   @default("cleared")
  type                  String
  system_transaction_id String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  bank_account BankAccount @relation(fields: [bank_account_id], references: [id])

  @@map("bank_transactions")
}

// --- Dynamics 365 Finance Core ---

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalStatus {
  draft
  posted
  voided
}

model Account {
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  type       AccountType
  parent_id  String?
  balance    Decimal     @default(0) @db.Decimal(15, 2)
  is_system  Boolean     @default(false) // If true, cannot be deleted (e.g. Retained Earnings)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  parent                Account?              @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children              Account[]             @relation("AccountHierarchy")
  journal_lines         JournalLine[]
  budget_lines          Budget[]
  budget_controls       BudgetControl[]
  stock_journal_entries StockJournalGLEntry[]

  @@map("accounts")
}

model JournalEntry {
  id          String        @id @default(uuid())
  date        DateTime      @db.Date
  description String
  reference   String?
  status      JournalStatus @default(draft)
  created_by  String
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  creator User          @relation(fields: [created_by], references: [id])
  lines   JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id               String  @id @default(uuid())
  journal_entry_id String
  account_id       String
  debit            Decimal @default(0) @db.Decimal(15, 2)
  credit           Decimal @default(0) @db.Decimal(15, 2)
  description      String?

  journal_entry JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [account_id], references: [id])

  @@map("journal_lines")
}

model Budget {
  id         String   @id @default(uuid())
  account_id String
  period     String // e.g. "2026-Q1" or "2026-03"
  amount     Decimal  @db.Decimal(15, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  account Account @relation(fields: [account_id], references: [id])

  @@unique([account_id, period])
  @@map("budgets")
}

// --- Customer Relationship Management (CRM) ---

enum LeadStatus {
  new
  contacted
  qualified
  lost
  converted
}

enum OpportunityStage {
  prospecting
  qualification
  proposal
  negotiation
  closed_won
  closed_lost
}

enum ActivityType {
  call
  email
  meeting
  task
  note
}

model Lead {
  id         String     @id @default(uuid())
  first_name String
  last_name  String
  email      String?
  phone      String?
  company    String?
  title      String?
  status     LeadStatus @default(new)
  source     String? // e.g. "Web", "Referral", "LinkedIn"
  score      Int        @default(0)

  owner_id String
  owner    User   @relation("LeadOwner", fields: [owner_id], references: [id])

  activities Activity[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model CustomerAccount {
  id                String  @id @default(uuid())
  name              String
  industry          String?
  website           String?
  phone             String?
  address           String?
  country_code      String? @default("US") // ISO country code for tax
  tax_id            String? // VAT/GST/Tax ID
  tax_exempt        Boolean @default(false)
  tax_exempt_reason String?

  owner_id String
  owner    User   @relation("AccountOwner", fields: [owner_id], references: [id])

  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  invoices      Invoice[]
  quotes        Quote[]
  sales_orders  SalesOrder[]
  credit_notes  CreditNote[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Contact {
  id         String           @id @default(uuid())
  account_id String?
  account    CustomerAccount? @relation(fields: [account_id], references: [id])

  first_name String
  last_name  String
  email      String?
  phone      String?
  title      String?

  activities Activity[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Opportunity {
  id         String          @id @default(uuid())
  account_id String
  account    CustomerAccount @relation(fields: [account_id], references: [id])

  name        String
  amount      Decimal          @default(0) @db.Decimal(15, 2)
  stage       OpportunityStage @default(prospecting)
  probability Int              @default(10) // Percentage 0-100
  close_date  DateTime?        @db.Date

  owner_id String
  owner    User   @relation("OpportunityOwner", fields: [owner_id], references: [id])

  activities Activity[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  subject     String
  description String?
  due_date    DateTime?
  completed   Boolean      @default(false)

  // Polymorphic-like associations (optional based on context)
  lead_id String?
  lead    Lead?   @relation(fields: [lead_id], references: [id])

  account_id String?
  account    CustomerAccount? @relation(fields: [account_id], references: [id])

  contact_id String?
  contact    Contact? @relation(fields: [contact_id], references: [id])

  opportunity_id String?
  opportunity    Opportunity? @relation(fields: [opportunity_id], references: [id])

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// --- Supply Chain Management (SCM) ---

enum ProductType {
  service
  goods
  digital
}

enum InventoryMovementType {
  in
  out
  transfer
  adjustment
  count
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        ProductType @default(goods)
  category    String?
  uom         String      @default("each") // Unit of Measure

  variants   ProductVariant[]
  attributes ProductAttribute[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ProductVariant {
  id         String  @id @default(uuid())
  product_id String
  product    Product @relation(fields: [product_id], references: [id])

  sku   String  @unique
  name  String // Generated from attributes (e.g. "T-Shirt - Red - L")
  price Decimal @default(0)
  cost  Decimal @default(0)

  reorder_point    Int @default(0)
  reorder_quantity Int @default(0)

  inventory    InventoryItem[]
  transactions InventoryTransaction[]

  // Phase 6 Relations
  price_list_items PriceListItem[]
  bundle_items     ProductBundleItem[]

  // Phase 7 Relations
  boms_as_finished_good BillOfMaterial[]
  boms_as_component     BomComponent[]
  production_orders     ProductionOrder[]
  production_components ProductionComponent[]

  // Stock Journal Relations
  stock_journal_lines StockJournalLine[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ProductAttribute {
  id         String  @id @default(uuid())
  product_id String
  product    Product @relation(fields: [product_id], references: [id])

  name  String // e.g. "Color"
  value String // e.g. "Red"
}

model Warehouse {
  id      String  @id @default(uuid())
  code    String  @unique
  name    String
  address String?

  locations Location[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Location {
  id           String    @id @default(uuid())
  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id])

  code String // e.g. "A-01-01"
  name String? // e.g. "Aisle A, Rack 1, Shelf 1"
  type String? // e.g. "Picking", "Bulk", "Returns"

  inventory InventoryItem[]
}

// Enhanced Inventory Item tracking specific location
model InventoryItem {
  id         String         @id @default(uuid())
  variant_id String
  variant    ProductVariant @relation(fields: [variant_id], references: [id])

  location_id String
  location    Location @relation(fields: [location_id], references: [id])

  quantity Decimal @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([variant_id, location_id])
}

model InventoryTransaction {
  id String @id @default(uuid())

  type InventoryMovementType

  variant_id String
  variant    ProductVariant @relation(fields: [variant_id], references: [id])

  from_location_id String?
  to_location_id   String?

  quantity  Decimal
  reference String? // PO Number, SO Number
  date      DateTime @default(now())

  created_by String
  user       User   @relation(fields: [created_by], references: [id])

  project_id String?
  project    Project? @relation(fields: [project_id], references: [id])
}

// --- Fixed Assets ---

enum AssetStatus {
  active
  disposed
  written_off
}

model FixedAsset {
  id                String   @id @default(uuid())
  name              String
  asset_number      String   @unique
  purchase_date     DateTime @db.Date
  purchase_cost     Decimal  @db.Decimal(15, 2)
  salvage_value     Decimal  @default(0) @db.Decimal(15, 2)
  useful_life_years Int

  // Depreciation tracking
  accumulated_depreciation Decimal   @default(0) @db.Decimal(15, 2)
  current_book_value       Decimal   @db.Decimal(15, 2) // purchase_cost - accumulated_depreciation
  last_depreciation_date   DateTime? @db.Date

  status        AssetStatus @default(active)
  location      String?
  serial_number String?

  // GL Integration (Simplification: linking to Accounts)
  asset_account_id        String
  depreciation_account_id String // Accumulated Depreciation (Contra Asset)
  expense_account_id      String // Depreciation Expense

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  depreciation_schedule DepreciationSchedule[]

  @@map("fixed_assets")
}

model DepreciationSchedule {
  id               String   @id @default(uuid())
  fixed_asset_id   String
  date             DateTime @db.Date
  amount           Decimal  @db.Decimal(15, 2)
  is_posted        Boolean  @default(false)
  journal_entry_id String?

  fixed_asset FixedAsset @relation(fields: [fixed_asset_id], references: [id], onDelete: Cascade)

  @@map("depreciation_schedules")
}

// --- Advanced Controls (Phase 5.2) ---

model ApprovalWorkflow {
  id            String   @id @default(uuid())
  entity_type   String // "Invoice", "Bill", "JournalEntry", "PurchaseOrder"
  min_amount    Decimal  @db.Decimal(15, 2)
  approver_role String? // e.g. "admin", "finance_manager"
  approver_id   String? // Specific user override
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([entity_type, min_amount])
  @@map("approval_workflows")
}

model ApprovalRequest {
  id          String @id @default(uuid())
  entity_type String
  entity_id   String
  status      String @default("pending") // pending, approved, rejected

  requested_by String
  requester    User   @relation("RequestedApprovals", fields: [requested_by], references: [id])

  approved_by String?
  approver    User?   @relation("ActionedApprovals", fields: [approved_by], references: [id])

  comments   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("approval_requests")
}

model BudgetControl {
  id              String  @id @default(uuid())
  account_id      String
  account         Account @relation(fields: [account_id], references: [id])
  period          String // "YYYY-MM" or "YYYY"
  limit_amount    Decimal @db.Decimal(15, 2)
  consumed_amount Decimal @default(0) @db.Decimal(15, 2)
  action          String  @default("warn") // "warn", "block"

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([account_id, period])
  @@map("budget_controls")
}

// --- Sales Operations (Quote-to-Cash) ---

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
  converted
}

model Quote {
  id           String      @id @default(uuid())
  number       String      @unique // QT-2025-001
  account_id   String
  project_id   String?
  issue_date   DateTime    @default(now()) @db.Date
  valid_until  DateTime    @db.Date
  status       QuoteStatus @default(draft)
  total_amount Decimal     @db.Decimal(15, 2)
  notes        String?
  terms        String?

  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  account CustomerAccount @relation(fields: [account_id], references: [id])
  project Project?        @relation(fields: [project_id], references: [id])
  creator User            @relation(fields: [created_by], references: [id])
  lines   QuoteLine[]
  orders  SalesOrder[]

  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(uuid())
  quote_id    String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  quote Quote @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@map("quote_lines")
}

enum OrderStatus {
  draft
  confirmed
  fulfilled
  cancelled
}

model SalesOrder {
  id           String      @id @default(uuid())
  number       String      @unique // SO-2025-001
  quote_id     String?
  account_id   String
  project_id   String?
  order_date   DateTime    @default(now()) @db.Date
  status       OrderStatus @default(draft)
  total_amount Decimal     @db.Decimal(15, 2)

  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  quote   Quote?           @relation(fields: [quote_id], references: [id])
  account CustomerAccount  @relation(fields: [account_id], references: [id])
  project Project?         @relation(fields: [project_id], references: [id])
  creator User             @relation(fields: [created_by], references: [id])
  lines   SalesOrderLine[]

  @@map("sales_orders")
}

model SalesOrderLine {
  id             String  @id @default(uuid())
  sales_order_id String
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unit_price     Decimal @db.Decimal(10, 2)
  total_price    Decimal @db.Decimal(10, 2)

  sales_order SalesOrder @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)

  @@map("sales_order_lines")
}

// --- Project Operations (Time & Expenses) ---

enum TimesheetStatus {
  draft
  submitted
  approved
  rejected
}

model TimesheetEntry {
  id          String          @id @default(uuid())
  project_id  String
  user_id     String // Employee
  date        DateTime        @db.Date
  hours       Decimal         @db.Decimal(5, 2)
  description String?
  billable    Boolean         @default(true)
  status      TimesheetStatus @default(draft)

  approver_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project  Project @relation(fields: [project_id], references: [id])
  user     User    @relation(fields: [user_id], references: [id])
  approver User?   @relation("TimesheetApprover", fields: [approver_id], references: [id])

  @@map("timesheet_entries")
}

enum ExpenseStatus {
  draft
  submitted
  approved
  rejected
  reimbursed
}

model ExpenseClaim {
  id          String        @id @default(uuid())
  project_id  String
  user_id     String // Employee
  date        DateTime      @db.Date
  amount      Decimal       @db.Decimal(10, 2)
  category    String // e.g. "Travel", "Meals"
  description String?
  receipt_url String?
  billable    Boolean       @default(true)
  status      ExpenseStatus @default(draft)

  approver_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project  Project @relation(fields: [project_id], references: [id])
  user     User    @relation(fields: [user_id], references: [id])
  approver User?   @relation("ExpenseApprover", fields: [approver_id], references: [id])

  @@map("expense_claims")
}

// --- Sales Operations (Part 2: Bundles & Price Lists) ---

model PriceList {
  id         String    @id @default(uuid())
  name       String
  currency   String    @default("USD")
  start_date DateTime? @db.Date // Optional validity period
  end_date   DateTime? @db.Date
  active     Boolean   @default(true)

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id            String  @id @default(uuid())
  price_list_id String
  variant_id    String
  price         Decimal @db.Decimal(10, 2)
  min_quantity  Int     @default(1) // Volume pricing support

  price_list PriceList      @relation(fields: [price_list_id], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variant_id], references: [id])

  @@unique([price_list_id, variant_id, min_quantity])
  @@map("price_list_items")
}

model ProductBundle {
  id          String  @id @default(uuid())
  name        String
  description String?
  sku         String  @unique
  price       Decimal @db.Decimal(10, 2)
  active      Boolean @default(true)

  items ProductBundleItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("product_bundles")
}

model ProductBundleItem {
  id         String @id @default(uuid())
  bundle_id  String
  variant_id String
  quantity   Int    @default(1)

  bundle  ProductBundle  @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@unique([bundle_id, variant_id])
  @@map("product_bundle_items")
}

// --- Project Operations (Part 2: Resource Scheduling) ---

enum BookingStatus {
  tentative
  confirmed
  cancelled
}

model ResourceBooking {
  id         String        @id @default(uuid())
  project_id String
  user_id    String // Resource
  start_date DateTime      @db.Date
  end_date   DateTime      @db.Date
  hours      Decimal       @db.Decimal(5, 2) // Total hours allocated or per day? Let's say Total for period for simplicity, or daily.
  // Actually, typically resource booking is "Booked for X hours/day from A to B".
  // Let's assume 'hours per day' for simpler allocation logic.
  status     BookingStatus @default(confirmed)
  notes      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@map("resource_bookings")
}

// --- Phase 7: Human Capital (HR Advanced) ---

enum GoalStatus {
  not_started
  in_progress
  completed
  cancelled
}

enum ReviewStatus {
  draft
  scheduled
  completed
  signed_off
}

model PerformanceGoal {
  id          String     @id @default(uuid())
  user_id     String
  title       String
  description String?
  status      GoalStatus @default(not_started)
  due_date    DateTime?  @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("performance_goals")
}

model PerformanceReview {
  id          String       @id @default(uuid())
  user_id     String // Employee being reviewed
  reviewer_id String // Manager/Reviewer
  cycle       String // e.g. "2025 Q1"
  status      ReviewStatus @default(draft)
  rating      Int? // 1-5
  feedback    String?      @db.Text

  review_date DateTime? @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User @relation("Reviewee", fields: [user_id], references: [id])
  reviewer User @relation("Reviewer", fields: [reviewer_id], references: [id])

  @@map("performance_reviews")
}

// --- Phase 7: Manufacturing (Production) ---

enum ProductionStatus {
  planned
  released
  in_progress
  completed
  cancelled
}

model BillOfMaterial {
  id         String  @id @default(uuid())
  name       String
  variant_id String // The finished good
  quantity   Decimal @default(1) // Yield quantity
  active     Boolean @default(true)

  components        BomComponent[]
  production_orders ProductionOrder[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("bill_of_materials")
}

model BomComponent {
  id         String  @id @default(uuid())
  bom_id     String
  variant_id String // The raw material/component
  quantity   Decimal @db.Decimal(10, 4) // Qty per BOM yield

  bom     BillOfMaterial @relation(fields: [bom_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("bom_components")
}

model ProductionOrder {
  id         String           @id @default(uuid())
  number     String           @unique // PROD-2025-001
  bom_id     String
  variant_id String // Redundant but useful for quick queries
  quantity   Decimal          @db.Decimal(10, 2)
  status     ProductionStatus @default(planned)

  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date

  components ProductionComponent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bom     BillOfMaterial @relation(fields: [bom_id], references: [id])
  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("production_orders")
}

model ProductionComponent {
  id                  String  @id @default(uuid())
  production_order_id String
  variant_id          String
  expected_qty        Decimal @db.Decimal(10, 4)
  actual_qty          Decimal @default(0) @db.Decimal(10, 4)

  production_order ProductionOrder @relation(fields: [production_order_id], references: [id], onDelete: Cascade)
  variant          ProductVariant  @relation(fields: [variant_id], references: [id])

  @@map("production_components")
}
